# ================================================================
# backend/.env.docker
# Loaded by docker-compose.yml via env_file.
# All hostnames use Docker service names (not localhost).
# ================================================================

NODE_ENV=development
LOCAL_IP=192.168.1.15

# Postgres — Docker service name
DATABASE_URL=postgresql://ottdev:ottdev123@postgres:5432/ott_dev

# JWT
JWT_SECRET=ott-access-secret-change-this-in-production-2024
JWT_REFRESH_SECRET=ott-refresh-secret-change-this-in-production-2024
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Admin seed
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin User

# Redis — Docker service name
REDIS_URL=redis://redis:6379

# MinIO internal (backend talks to minio container)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=ott-media
MINIO_USE_SSL=false

# ── THE ONLY 2 LINES YOU CHANGE WHEN SWITCHING MACHINES ──────
# Your dev machine IP for now. Change to office server IP later.
MINIO_PUBLIC_HOST=http://${LOCAL_IP}:8080    # dev machine IP
SERVER_ORIGIN=http://${LOCAL_IP}:8080    # dev machine IP

# ── Cloudflare CDN ────────────────────────────────────────────
# CF_ORIGIN: your Cloudflare-proxied public domain.
# app.js adds this to the CORS allowed list.
CF_ORIGIN=https://ventaott.com

# Public URL for live HLS playback links returned to clients
LIVE_PUBLIC_BASE_URL=https://ventaott.com

# HLS_SIGNING_SECRET: CHANGE THIS before going live.
# Cloudflare makes /hls/ URLs publicly reachable —
# a guessable secret lets anyone forge valid stream links.
# Generate with: openssl rand -hex 32
HLS_SIGNING_SECRET=0cc3d9a7f14d3cfe6eb43055be850b6a066b57c6564416ae18dc16573c75a6d5
# ─────────────────────────────────────────────────────────────

# Live streaming (MediaMTX) — Part 1+
MEDIAMTX_RTMP_HOST=mediamtx
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_WHIP_HOST=${LOCAL_IP}
MEDIAMTX_WHIP_PORT=8889
MEDIAMTX_HLS_HOST=mediamtx
MEDIAMTX_HLS_PORT=8888

SMTP_SERVICE=gmail

SMTP_USER=vishnu123uplenchwar@gmail.com

SMTP_PASS=rxrtblofyexazqgj

SMTP_SERVICE=gmail

SMTP_USER=vishnu123uplenchwar@gmail.com

SMTP_PASS=rxrtblofyexazqgj

SMTP_FROM=vishnu123uplenchwar@gmail.com

# Cashfree Payment Gateway
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01


# Run this command in terminal and keep the terminal on - 
#npx localtunnel --port 8080 

# Paste the url instead of https://orange-monkeys-type.loca.lt

CASHFREE_WEBHOOK_URL=https://upset-moles-shout.loca.lt/api/v1/payments/webhook

# Return URL placeholder (not strictly used by mobile webview, but required by Cashfree backend)
CASHFREE_RETURN_URL=https://sandbox.cashfree.com/
CASHFREE_ORDER_EXPIRY_MINUTES=30
