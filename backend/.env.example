# Example environment variables
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Application Environment
NODE_ENV="development"
PORT=3000

# Debug Options
DEBUG_QUERIES=false
LOG_LEVEL="info"

# App Info
APP_NAME="OTT Backend"

# ── Live streaming (MediaMTX) — Part 1+ ─────────────────────
# RTMP URL for OBS: rtmp://<host>:1935/live  (stream key = path suffix)
MEDIAMTX_RTMP_HOST=localhost
MEDIAMTX_RTMP_PORT=1935
# WHIP base (HTTPS required in browsers except localhost)
MEDIAMTX_WHIP_HOST=localhost
MEDIAMTX_WHIP_PORT=8889
# HLS origin (nginx proxies /live/hls/ in Part 3)
MEDIAMTX_HLS_HOST=localhost
MEDIAMTX_HLS_PORT=8888
# Public base URL shown to admins (use LOCAL_IP:8080 in Docker)
LIVE_PUBLIC_BASE_URL=http://localhost:8080

# Cashfree Payment Gateway
CASHFREE_APP_ID=xxxxxxxxxxxxxxxx
CASHFREE_SECRET_KEY=xxxxxxxxxxxxxxxx
CASHFREE_ENV=SANDBOX
CASHFREE_API_VERSION=2023-08-01
CASHFREE_WEBHOOK_URL=xxxxxxxxxxxxxxxx
CASHFREE_RETURN_URL=xxxxxxxxxxxxxxxx
CASHFREE_ORDER_EXPIRY_MINUTES=30

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=xxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx
PAYSTACK_ENV=TEST
PAYSTACK_DEFAULT_CURRENCY=NGN
PAYSTACK_CALLBACK_URL=xxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co

